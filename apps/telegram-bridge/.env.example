# From my.telegram.org → API development tools (logged in as the OnFloor Line account)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Run `uv run login.py` once; it saves this value directly. FULL ACCOUNT ACCESS: never commit.
TELEGRAM_SESSION_STRING=
# Must equal BRIDGE_SECRET in apps/server/.env
BRIDGE_SECRET=dev-bridge-secret-change-me
API_INGEST_URL=ws://localhost:3000/internal/live/ingest
# Hosted API: use wss://<api-host>/internal/live/ingest. Telegram values stay on this laptop.
# Optional: sounddevice device id or name (`uv run bridge.py --list-devices`).
MIC_DEVICE=
SPEAKER_DEVICE=
BACKUP_DIR=.data/recordings
