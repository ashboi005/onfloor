# Copy to apps/server/.env. Full list + docs: apps/server/.env.schema (varlock validates at boot).
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# LLM: merge | gemini (per-job overrides: LLM_PROVIDER_ROLEPLAY / _COPILOT / _SCORING / _PERSONA)
LLM_PROVIDER=merge
MERGE_API_KEY=
# Up to 4 Gemini keys, rotated per call. Each from a DIFFERENT Google Cloud project (quota is per project).
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# Telegram bridge shared secret (same value in apps/telegram-bridge/.env)
BRIDGE_SECRET=dev-bridge-secret-change-me
LIVE_AGENT_EMAIL=ashwath@onfloor.demo

# true = replay fixture calls instead of the real engines (no keys needed). false = real AI.
STUB_ENGINES=false
STUB_SPEED=1

# RAG (Qdrant). Empty = RAG off. Local: docker run -p 6333:6333 qdrant/qdrant
VECTOR_DATABASE_URL=
VECTOR_DATABASE_API_KEY=
