# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public URLs, not secrets. Marked non-sensitive so varlock's leak guard doesn't block
# responses that contain them (e.g. recording URLs built from BETTER_AUTH_URL).
# @type=url @sensitive=false
BETTER_AUTH_URL=

# @type=url @sensitive=false
CORS_ORIGIN=

# Session cookie parent domain when the API and the web app are on different subdomains
# (e.g. ashwathsoni.dev for onfloor-api.ashwathsoni.dev + onfloor.ashwathsoni.dev). Optional:
# derived from BETTER_AUTH_URL and CORS_ORIGIN when unset.
# @optional @sensitive=false
AUTH_COOKIE_DOMAIN=

# @type=string(minLength=1)
DATABASE_URL=

# ===========================================================================
# OnFloor. Everything below is optional at boot; a service that needs a missing
# key throws a clean AppError when it is actually used.
# ===========================================================================

# @public @type=number
PORT=3000

# --- LLM: provider toggle -----------------------------------------------------
# Default provider for every job; each job can be overridden below.
# @public @type=enum(merge, gemini)
LLM_PROVIDER=merge
# @optional @public @type=enum(merge, gemini)
LLM_PROVIDER_ROLEPLAY=
# @optional @public @type=enum(merge, gemini)
LLM_PROVIDER_COPILOT=
# @optional @public @type=enum(merge, gemini)
LLM_PROVIDER_SCORING=
# @optional @public @type=enum(merge, gemini)
LLM_PROVIDER_PERSONA=
# reasoning_effort sent for the scoring tier only (none | minimal | low | medium).
# Non-lite Gemini models spend max_tokens on hidden reasoning without it and return nothing.
# @public @type=enum(none, minimal, low, medium)
LLM_SCORING_REASONING=low
# English subtitles (job "translate"). Defaults to merge and never falls back to Gemini.
# @optional @public @type=enum(merge, gemini)
LLM_PROVIDER_TRANSLATE=
# On a 429/5xx from one provider, retry once on the other (if it has a key).
# @public @type=boolean
LLM_FALLBACK=true

# Merge Gateway (OpenAI-compatible)
# @optional
MERGE_API_KEY=
# @public @type=url
MERGE_BASE_URL=https://api-gateway.merge.dev/v1/openai
# Model ids as listed in the Merge dashboard. Verify with `bun run llm:check`.
# @public
MERGE_MODEL_ROLEPLAY=zai/glm-5.3-flash
# @public
MERGE_MODEL_FAST=zai/glm-5.3-flash
# @public
MERGE_MODEL_SCORING=zai/glm-5.3-flash
# English subtitles. Measured 2026-10-10 on tricky Hinglish lines: gpt-5.4-mini ~1.1s and accurate;
# glm-5.3-flash ~2.3s and reversed meaning ("10% kam hai" → "10% is fine"); claude-haiku-5-5 ~1.4s, accurate.
# @public
MERGE_MODEL_TRANSLATE=gpt-5.4-mini

# Google Gemini (OpenAI-compatible endpoint).
# Measured 2026-10-10 (roleplay line): 3.5-flash-lite ~1.8s, 3.1-flash-lite ~1.6s,
# 3.5-flash (reasoning=low) ~2s, 3.8-flash 90s+ (do not use for anything interactive).
# Up to 4 keys, rotated round-robin per call with per-key cooldowns on 429/503.
# Quotas are per Google Cloud PROJECT, so each key must come from a different project.
# @optional
GEMINI_API_KEY=
# @optional
GEMINI_API_KEY_2=
# @optional
GEMINI_API_KEY_3=
# @optional
GEMINI_API_KEY_4=
# @public @type=url
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# @public
GEMINI_MODEL_ROLEPLAY=gemini-3.5-flash-lite
# @public
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# Judge + persona extraction. Flash-lite: ~4s per scorecard (measured) vs 8-15s for gemini-3.5-flash,
# whose free-tier daily quota also runs out first. Gemini quotas are per model.
# @public
GEMINI_MODEL_SCORING=gemini-3.5-flash-lite

# --- Voice ------------------------------------------------------------------
# @optional
ELEVENLABS_API_KEY=
# Fallback voice when a persona's voiceId is unusable (bare ElevenLabs id).
# @optional @public
ELEVENLABS_VOICE_ID=
# Must be multilingual: eleven_flash_v2 is English-only and mangles Hindi.
# @public
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# @public
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# @optional
SARVAM_API_KEY=
# bulbul:v2 rejects the v3 speaker names (rehan, kabir) the personas use.
# @public
SARVAM_TTS_MODEL=bulbul:v3

# --- Storage (local disk for the hackathon) -----------------------------------
# @public
STORAGE_DIR=./.data/storage

# --- Live / Telegram bridge (Tushar) ---------------------------------------------
# Shared secret the Python bridge sends as `x-bridge-secret` on /internal/live/ingest.
# @optional
BRIDGE_SECRET=
# @public @type=enum(en, hi, hinglish)
LIVE_DEFAULT_LANGUAGE=hinglish
# The OnFloor agent who answers the Telegram line (calls are attributed to them).
# @public
LIVE_AGENT_EMAIL=ashwath@onfloor.demo
# Replay fixture timelines over /ws/sim and /ws/live instead of running the real engines.
# Lets the frontend integrate against the real server before the engines exist.
# @public @type=boolean
STUB_ENGINES=true
# Playback speed of those fixture timelines (1 = real time; 10 for quick tests).
# @public @type=number
STUB_SPEED=1

# --- Knowledge / RAG (Mastra + Qdrant) ------------------------------------------
# Qdrant URL, e.g. http://localhost:6333 or a Qdrant Cloud cluster URL.
# Empty = RAG off: every retrieve() returns [] and ingest() is a no-op.
# @optional
VECTOR_DATABASE_URL=
# Qdrant Cloud API key (not needed for a local container).
# @optional
VECTOR_DATABASE_API_KEY=
# @public
KNOWLEDGE_COLLECTION=onfloor_knowledge
# Embeddings always go through Gemini (key pool) and never fall back to another provider:
# vectors from different models can't share one collection. Changing the model or the
# dimensions means re-ingesting (drop the collection).
# @public
EMBEDDING_MODEL=gemini-embedding-001
# @public @type=number
EMBEDDING_DIMENSIONS=768
